# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase with Row Level Security)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication Secret
JWT_SECRET=super-secret-pg-manager-jwt-token-key-2026

# Cloudflare R2 Object Storage (10 GB Free, Zero Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=pg-kyc-documents

# Optional: Meta WhatsApp Cloud API (For 1st-of-month Automated Blasts)
WHATSAPP_CLOUD_API_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
